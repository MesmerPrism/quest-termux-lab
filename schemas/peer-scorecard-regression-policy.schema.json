{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-scorecard-regression-policy.schema.json",
  "title": "Quest Termux Lab Peer Scorecard Regression Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "fleet_id",
    "source_agent_id",
    "experiment_scope",
    "min_report_count",
    "allow_single_sample_review",
    "allow_manual_review_history",
    "require_non_worsening_overall",
    "max_new_pressure_point_count",
    "max_worsening_artifact_count",
    "max_persistent_pressure_point_count",
    "max_last_blocked_count",
    "max_last_missing_count",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-scorecard-regression-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "min_report_count": {
      "type": "integer",
      "minimum": 0
    },
    "allow_single_sample_review": {
      "type": "boolean"
    },
    "allow_manual_review_history": {
      "type": "boolean"
    },
    "require_non_worsening_overall": {
      "type": "boolean"
    },
    "max_new_pressure_point_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_worsening_artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_persistent_pressure_point_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_last_blocked_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_last_missing_count": {
      "type": "integer",
      "minimum": 0
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
