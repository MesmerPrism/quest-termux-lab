{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-private-result-placeholder-manifest.schema.json",
  "title": "Quest Termux Lab Peer Private Result Placeholder Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "placeholder_id",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "import_plan_report_path",
    "require_import_ready",
    "require_derivative_schemas",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-private-result-placeholder-manifest.v1"
    },
    "placeholder_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "import_plan_report_path": {
      "type": "string",
      "minLength": 1
    },
    "require_import_ready": {
      "type": "boolean"
    },
    "require_derivative_schemas": {
      "type": "boolean"
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
