{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/evidence-record.schema.json",
  "title": "Quest Termux Lab Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "test_id",
    "started_at",
    "provider",
    "result",
    "classification",
    "observations",
    "cleanup"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.evidence-record.v1"
    },
    "test_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,80}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "enum": ["host_adb", "termux", "operator", "companion", "other"]
    },
    "result": {
      "enum": ["pass", "pass_with_limits", "partial", "fail", "blocked", "not_run"]
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "redacted": { "type": "boolean", "default": true }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "verified"],
      "properties": {
        "attempted": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}

