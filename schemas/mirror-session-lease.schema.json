{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/mirror-session-lease.schema.json",
  "title": "Quest Termux Lab Mirror Session Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "lease_id",
    "operator_id",
    "source_agent_id",
    "target_agent_id",
    "purpose",
    "issued_at",
    "expires_at",
    "consent_mode",
    "allowed_command_kinds",
    "requires_target_consent",
    "requires_local_adb_shell_for_adb_commands",
    "active_indicator_required",
    "emergency_stop_supported",
    "sensitivity",
    "revoked"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.mirror-session-lease.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,100}$"
    },
    "operator_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_mode": {
      "enum": [
        "operator_visible_lab",
        "local_user_confirmed",
        "managed_device_policy"
      ]
    },
    "allowed_command_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "agent.status",
          "agent.capabilities",
          "adb.lease_check",
          "android.foreground_snapshot",
          "app.launch_allowlisted",
          "uiautomator.run_allowlisted_scenario",
          "adb.lease_disconnect"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires_target_consent": {
      "type": "boolean"
    },
    "requires_local_adb_shell_for_adb_commands": {
      "type": "boolean"
    },
    "active_indicator_required": {
      "type": "boolean"
    },
    "emergency_stop_supported": {
      "type": "boolean"
    },
    "sensitivity": {
      "enum": ["public_safe", "local_only", "private_evidence"]
    },
    "revoked": {
      "type": "boolean"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "revoked_by": {
      "type": ["string", "null"]
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
