{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-delivery-state.schema.json",
  "title": "Quest Termux Lab Peer Delivery State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "deliveries",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-delivery-state.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_id",
          "target_agent_id",
          "message_id",
          "state",
          "created_at",
          "expires_at",
          "attempt_count",
          "last_attempt_at",
          "last_receipt_status",
          "last_error"
        ],
        "properties": {
          "delivery_id": {
            "type": "string",
            "minLength": 1
          },
          "target_agent_id": {
            "type": "string",
            "minLength": 1
          },
          "message_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": ["pending", "accepted", "duplicate", "rejected", "expired"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_attempt_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_receipt_status": {
            "type": ["string", "null"],
            "enum": ["accepted", "duplicate", null]
          },
          "last_error": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_count",
        "pending_count",
        "accepted_count",
        "duplicate_count",
        "rejected_count",
        "expired_count",
        "terminal_count"
      ],
      "properties": {
        "delivery_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "expired_count": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
