{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/fleet-agent-manifest.schema.json",
  "title": "Quest Termux Lab Fleet Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "agent_id",
    "agent_label",
    "agent_version",
    "transport_mode",
    "central_endpoint",
    "allowed_command_kinds",
    "supports_local_adb",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.fleet-agent-manifest.v1"
    },
    "fleet_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "agent_label": {
      "type": "string",
      "minLength": 1
    },
    "agent_version": {
      "type": "string",
      "minLength": 1
    },
    "transport_mode": {
      "enum": ["outbound_http_poll", "outbound_websocket_future"]
    },
    "central_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "allowed_command_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_update_packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signing_cert_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "allowed_rollout_rings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "launch_components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "allowed_launch_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_logcat_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_uiautomator_scenarios": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrumentation", "allowed_extras"],
        "properties": {
          "instrumentation": {
            "type": "string",
            "minLength": 1
          },
          "allowed_extras": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,48}$"
            },
            "uniqueItems": true
          },
          "default_extras": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "integer", "boolean"]
            }
          }
        }
      }
    },
    "local_workspace_root": {
      "type": "string"
    },
    "supports_local_adb": {
      "type": "boolean"
    },
    "public_safe_profile": {
      "type": "boolean",
      "default": true
    },
    "synthetic": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
