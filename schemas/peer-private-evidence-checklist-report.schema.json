{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-private-evidence-checklist-report.schema.json",
  "title": "Quest Termux Lab Peer Private Evidence Checklist Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "checklist_id",
    "experiment_scope",
    "handoff_status",
    "overall_status",
    "checks",
    "private_evidence_items",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-private-evidence-checklist-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checklist_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "handoff_status": {
      "enum": ["handoff_ready", "manual_review", "handoff_blocked"]
    },
    "overall_status": {
      "enum": ["checklist_ready", "manual_review", "checklist_blocked"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "observed", "threshold", "reason"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "manual_review", "failed"]
          },
          "observed": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "private_evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "evidence_kind",
          "expected_schema",
          "required",
          "collection_status",
          "public_placeholder",
          "reason"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "type": "string",
            "minLength": 1
          },
          "expected_schema": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "collection_status": {
            "enum": ["pending_private_run", "optional_pending_private_run"]
          },
          "public_placeholder": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "passed_check_count",
        "manual_review_check_count",
        "failed_check_count",
        "private_evidence_item_count",
        "required_private_evidence_item_count",
        "optional_private_evidence_item_count"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "private_evidence_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_private_evidence_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "optional_private_evidence_item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
