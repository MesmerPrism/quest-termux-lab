{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-preflight-clear-fixture-manifest.schema.json",
  "title": "Quest Termux Lab Peer Preflight Clear Fixture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture_id",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "route_config_path",
    "topology_manifest_path",
    "readiness_policy_template_path",
    "lab_bundle_manifest_template_path",
    "route_health_observed_at",
    "output_paths",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-preflight-clear-fixture-manifest.v1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "route_config_path": {
      "type": "string",
      "minLength": 1
    },
    "topology_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "readiness_policy_template_path": {
      "type": "string",
      "minLength": 1
    },
    "lab_bundle_manifest_template_path": {
      "type": "string",
      "minLength": 1
    },
    "route_health_observed_at": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "format": "date-time"
      }
    },
    "output_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_health_reports",
        "route_health_history",
        "readiness_policy",
        "readiness_report",
        "topology_report",
        "lab_bundle_manifest",
        "lab_bundle_report"
      ],
      "properties": {
        "route_health_reports": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_health_history": {
          "type": "string",
          "minLength": 1
        },
        "readiness_policy": {
          "type": "string",
          "minLength": 1
        },
        "readiness_report": {
          "type": "string",
          "minLength": 1
        },
        "topology_report": {
          "type": "string",
          "minLength": 1
        },
        "lab_bundle_manifest": {
          "type": "string",
          "minLength": 1
        },
        "lab_bundle_report": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
