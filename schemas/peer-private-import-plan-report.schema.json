{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-private-import-plan-report.schema.json",
  "title": "Quest Termux Lab Peer Private Import Plan Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "import_plan_id",
    "experiment_scope",
    "package_status",
    "redaction_status",
    "overall_status",
    "checks",
    "import_items",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-private-import-plan-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "import_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "package_status": {
      "enum": ["package_ready", "manual_review", "package_blocked"]
    },
    "redaction_status": {
      "enum": ["redaction_ready", "manual_review", "redaction_blocked"]
    },
    "overall_status": {
      "enum": ["import_ready", "manual_review", "import_blocked"]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "import_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import_item"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "passed_check_count",
        "manual_review_check_count",
        "failed_check_count",
        "import_item_count",
        "private_only_item_count",
        "ready_derivative_item_count",
        "blocked_derivative_item_count",
        "missing_derivative_schema_count"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "import_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "private_only_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_derivative_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_derivative_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_derivative_schema_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "observed", "threshold", "reason"],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "manual_review", "failed"]
        },
        "observed": {
          "type": "string"
        },
        "threshold": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "import_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "evidence_kind",
        "expected_schema",
        "required",
        "collection_status",
        "public_release",
        "public_derivative_schema",
        "import_status",
        "reason"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "expected_schema": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "collection_status": {
          "enum": ["pending_private_run", "optional_pending_private_run"]
        },
        "public_release": {
          "enum": ["sanitized_derivative_only", "private_only", ""]
        },
        "public_derivative_schema": {
          "type": "string"
        },
        "import_status": {
          "enum": [
            "ready_for_public_derivative",
            "blocked_until_redaction_ready",
            "private_only",
            "missing_derivative_schema"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
