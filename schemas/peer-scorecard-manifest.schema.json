{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-scorecard-manifest.schema.json",
  "title": "Quest Termux Lab Peer Scorecard Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "scorecard_id",
    "experiment_scope",
    "required_artifact_kinds",
    "optional_artifact_kinds",
    "artifact_paths",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-scorecard-manifest.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "required_artifact_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "readiness_report",
          "lab_bundle_report",
          "trust_report",
          "rehearsal_report",
          "evidence_intake_report",
          "route_health_report",
          "route_history_report",
          "cleanup_record"
        ]
      }
    },
    "optional_artifact_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "readiness_report",
          "lab_bundle_report",
          "trust_report",
          "rehearsal_report",
          "evidence_intake_report",
          "route_health_report",
          "route_history_report",
          "cleanup_record"
        ]
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "lab_bundle_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "trust_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "rehearsal_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "evidence_intake_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "route_health_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "route_history_report": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        },
        "cleanup_record": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
