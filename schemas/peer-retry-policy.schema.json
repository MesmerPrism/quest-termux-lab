{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-retry-policy.schema.json",
  "title": "Quest Termux Lab Peer Retry Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "max_attempts",
    "min_retry_delay_seconds",
    "max_retry_delay_seconds",
    "backoff_multiplier",
    "retryable_errors",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-retry-policy.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "min_retry_delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "max_retry_delay_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "backoff_multiplier": {
      "type": "number",
      "minimum": 1
    },
    "retryable_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
