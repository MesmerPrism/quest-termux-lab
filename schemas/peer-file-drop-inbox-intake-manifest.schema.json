{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-file-drop-inbox-intake-manifest.schema.json",
  "title": "Quest Termux Lab Peer File-Drop Inbox Intake Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intake_id",
    "fleet_id",
    "source_agent_id",
    "receiver_agent_id",
    "observed_at",
    "experiment_scope",
    "expected_message_schema",
    "inbox_entries",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-file-drop-inbox-intake-manifest.v1"
    },
    "intake_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "receiver_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "expected_message_schema": {
      "const": "quest-termux-lab.peer-gossip-envelope.v1"
    },
    "inbox_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inbox_entry"
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "inbox_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "target_agent_id",
        "message_id",
        "relative_staging_path",
        "simulated_presence",
        "envelope_path",
        "reason"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "minLength": 1
        },
        "target_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_staging_path": {
          "type": "string",
          "minLength": 1
        },
        "simulated_presence": {
          "enum": [
            "simulated_present",
            "simulated_duplicate_file",
            "simulated_missing_file",
            "simulated_unreadable_file",
            "simulated_invalid_envelope"
          ]
        },
        "envelope_path": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
