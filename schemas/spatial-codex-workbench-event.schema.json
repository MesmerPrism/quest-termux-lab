{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/spatial-codex-workbench-event.schema.json",
  "title": "Spatial Codex Workbench event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "operation_id", "kind", "status", "summary", "occurred_at"],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.spatial-codex-workbench-event.v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "run_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "status": {
      "enum": ["pending", "running", "pass", "partial", "fail", "blocked", "canceled"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
