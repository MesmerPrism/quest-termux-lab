{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-cleanup-plan-report.schema.json",
  "title": "Quest Termux Lab Peer Cleanup Plan Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "cleanup_plan_id",
    "experiment_scope",
    "overall_status",
    "required_cleanup_kinds",
    "cleanup_steps",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-cleanup-plan-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cleanup_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "overall_status": {
      "enum": ["cleanup_plan_ready", "cleanup_plan_blocked"]
    },
    "required_cleanup_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cleanup_step_report"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_count",
        "planned_step_count",
        "missing_step_count",
        "required_cleanup_kind_count",
        "observed_required_cleanup_kind_count",
        "missing_required_cleanup_kind_count",
        "evidence_kind_count"
      ],
      "properties": {
        "step_count": {
          "type": "integer",
          "minimum": 0
        },
        "planned_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_cleanup_kind_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_required_cleanup_kind_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_cleanup_kind_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_kind_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "cleanup_step_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "cleanup_kind",
        "timing",
        "required",
        "expected_evidence_kind",
        "status",
        "reason"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "cleanup_kind": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "enum": ["pre_run", "post_run", "post_evidence", "final_review"]
        },
        "required": {
          "type": "boolean"
        },
        "expected_evidence_kind": {
          "enum": [
            "none",
            "cleanup_record",
            "route_health_report",
            "route_history_report",
            "evidence_intake_report",
            "scorecard_report"
          ]
        },
        "status": {
          "enum": ["planned", "missing"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
