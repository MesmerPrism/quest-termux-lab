{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/mirror-command-intent.schema.json",
  "title": "Quest Termux Lab Mirror Command Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "mirror_intent_id",
    "lease_id",
    "source_agent_id",
    "target_agent_id",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "kind",
    "requires_local_adb_shell",
    "payload",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.mirror-command-intent.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "mirror_intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,100}$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,100}$"
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "agent.status",
        "agent.capabilities",
        "adb.lease_check",
        "android.foreground_snapshot",
        "app.launch_allowlisted",
        "uiautomator.run_allowlisted_scenario",
        "adb.lease_disconnect"
      ]
    },
    "requires_local_adb_shell": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "max_stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "max_stderr_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "enum": ["public_safe", "local_only", "private_evidence"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
