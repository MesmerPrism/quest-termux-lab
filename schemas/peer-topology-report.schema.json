{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-topology-report.schema.json",
  "title": "Quest Termux Lab Peer Topology Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "topology_id",
    "experiment_scope",
    "overall_status",
    "checks",
    "expected_agent_ids",
    "edges",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-topology-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "overall_status": {
      "enum": ["topology_ready", "manual_review", "topology_blocked"]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "expected_agent_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_agent_count",
        "expected_target_count",
        "edge_count",
        "configured_edge_count",
        "missing_route_count",
        "missing_health_count",
        "reachable_edge_count",
        "degraded_edge_count",
        "unreachable_edge_count",
        "reachable_agent_count",
        "non_ready_edge_count"
      ],
      "properties": {
        "expected_agent_count": {
          "type": "integer",
          "minimum": 0
        },
        "expected_target_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "configured_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_route_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_health_count": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "degraded_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_agent_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_ready_edge_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "observed", "threshold", "reason"],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "manual_review", "failed"]
        },
        "observed": {
          "type": "string"
        },
        "threshold": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_agent_id",
        "target_agent_id",
        "configured",
        "transport_mode",
        "route_health_status",
        "reachability_status",
        "reason"
      ],
      "properties": {
        "source_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "target_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "configured": {
          "type": "boolean"
        },
        "transport_mode": {
          "enum": ["file_drop_simulator", "loopback_http_simulator", "disabled", "none"]
        },
        "route_health_status": {
          "type": ["string", "null"],
          "enum": ["healthy", "degraded", "unavailable", "disabled", "unknown", null]
        },
        "reachability_status": {
          "enum": [
            "reachable",
            "degraded",
            "unreachable",
            "disabled",
            "unknown",
            "missing_health",
            "missing_route"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
