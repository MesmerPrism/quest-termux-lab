{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-private-evidence-redaction-report.schema.json",
  "title": "Quest Termux Lab Peer Private Evidence Redaction Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "redaction_id",
    "checklist_id",
    "experiment_scope",
    "checklist_status",
    "overall_status",
    "checks",
    "redaction_items",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-private-evidence-redaction-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "redaction_id": {
      "type": "string",
      "minLength": 1
    },
    "checklist_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "checklist_status": {
      "enum": ["checklist_ready", "manual_review", "checklist_blocked"]
    },
    "overall_status": {
      "enum": ["redaction_ready", "manual_review", "redaction_blocked"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "observed", "threshold", "reason"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "manual_review", "failed"]
          },
          "observed": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "redaction_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "evidence_kind",
          "expected_schema",
          "required",
          "collection_status",
          "public_release",
          "public_derivative_schema",
          "redaction_status",
          "forbidden_value_classes",
          "required_redaction_notes",
          "reason"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "type": "string",
            "minLength": 1
          },
          "expected_schema": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "collection_status": {
            "enum": ["pending_private_run", "optional_pending_private_run"]
          },
          "public_release": {
            "enum": ["sanitized_derivative_only", "private_only", ""]
          },
          "public_derivative_schema": {
            "type": "string"
          },
          "redaction_status": {
            "enum": [
              "blocked_until_private_evidence",
              "ready_for_sanitized_derivative",
              "private_only"
            ]
          },
          "forbidden_value_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_redaction_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "passed_check_count",
        "manual_review_check_count",
        "failed_check_count",
        "redaction_item_count",
        "required_redaction_item_count",
        "private_only_item_count",
        "sanitized_derivative_item_count",
        "ready_derivative_item_count",
        "blocked_redaction_item_count",
        "missing_rule_count"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "redaction_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_redaction_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "private_only_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "sanitized_derivative_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_derivative_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_redaction_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_rule_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
