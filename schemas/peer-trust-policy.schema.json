{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-trust-policy.schema.json",
  "title": "Quest Termux Lab Peer Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "policy_id",
    "experiment_scope",
    "allowed_agent_ids",
    "allowed_transport_modes",
    "required_message_schema",
    "max_hop_ttl",
    "min_sample_envelopes",
    "require_configured_peers_only",
    "require_trusted_bundle_status",
    "operator_review_required",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-trust-policy.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "allowed_agent_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_transport_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["file_drop_simulator", "loopback_http_simulator", "disabled"]
      }
    },
    "required_message_schema": {
      "const": "quest-termux-lab.peer-gossip-envelope.v1"
    },
    "max_hop_ttl": {
      "type": "integer",
      "minimum": 1
    },
    "min_sample_envelopes": {
      "type": "integer",
      "minimum": 0
    },
    "require_configured_peers_only": {
      "type": "boolean"
    },
    "require_trusted_bundle_status": {
      "type": "boolean"
    },
    "operator_review_required": {
      "type": "boolean"
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
