{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-live-lab-readiness-report.schema.json",
  "title": "Quest Termux Lab Peer Live Lab Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "overall_status",
    "checks",
    "routes",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-live-lab-readiness-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "overall_status": {
      "enum": ["ready", "manual_review", "not_ready"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "expected",
          "observed",
          "reason"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "failed", "manual_review"]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_agent_id",
          "last_status",
          "trend",
          "sample_count",
          "readiness_status",
          "reason"
        ],
        "properties": {
          "target_agent_id": {
            "type": "string",
            "minLength": 1
          },
          "last_status": {
            "enum": ["healthy", "degraded", "unavailable", "disabled", "unknown"]
          },
          "trend": {
            "enum": ["stable", "improving", "worsening", "mixed", "single_sample"]
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "readiness_status": {
            "enum": ["ready", "not_ready"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "passed_check_count",
        "failed_check_count",
        "manual_review_check_count",
        "route_count",
        "ready_route_count",
        "not_ready_route_count"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_route_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_ready_route_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
