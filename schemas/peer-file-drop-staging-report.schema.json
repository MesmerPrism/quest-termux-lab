{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-file-drop-staging-report.schema.json",
  "title": "Quest Termux Lab Peer File-Drop Staging Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "staging_plan_id",
    "experiment_scope",
    "route_config_path",
    "delivery_state_path",
    "expected_message_schema",
    "dispatch_summary",
    "staging_entries",
    "summary",
    "overall_status",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-file-drop-staging-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "staging_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "route_config_path": {
      "type": "string",
      "minLength": 1
    },
    "delivery_state_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_message_schema": {
      "const": "quest-termux-lab.peer-gossip-envelope.v1"
    },
    "dispatch_summary": {
      "$ref": "#/$defs/dispatch_summary"
    },
    "staging_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/staging_entry"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_count",
        "ready_dispatch_count",
        "entry_count",
        "planned_count",
        "skipped_non_file_drop_count",
        "skipped_not_ready_count"
      ],
      "properties": {
        "dispatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_dispatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "planned_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_non_file_drop_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_not_ready_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "overall_status": {
      "enum": ["file_drop_staging_ready", "manual_review", "file_drop_staging_blocked"]
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "dispatch_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_count",
        "ready_count",
        "skipped_terminal_count",
        "expired_count",
        "missing_route_count",
        "route_disabled_count"
      ],
      "properties": {
        "dispatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_terminal_count": {
          "type": "integer",
          "minimum": 0
        },
        "expired_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_route_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_disabled_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "staging_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "target_agent_id",
        "message_id",
        "dispatch_decision",
        "transport_mode",
        "method",
        "target_inbox_dir",
        "staging_filename",
        "relative_staging_path",
        "message_schema",
        "status",
        "reason"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "minLength": 1
        },
        "target_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_decision": {
          "enum": ["ready", "skipped_terminal", "expired", "missing_route", "route_disabled"]
        },
        "transport_mode": {
          "enum": ["file_drop_simulator", "loopback_http_simulator", "none", "disabled"]
        },
        "method": {
          "enum": ["copy_envelope", "post_gossip", "none"]
        },
        "target_inbox_dir": {
          "type": ["string", "null"]
        },
        "staging_filename": {
          "type": ["string", "null"]
        },
        "relative_staging_path": {
          "type": ["string", "null"]
        },
        "message_schema": {
          "const": "quest-termux-lab.peer-gossip-envelope.v1"
        },
        "status": {
          "enum": ["planned", "skipped_non_file_drop", "skipped_not_ready"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
