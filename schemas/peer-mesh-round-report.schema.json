{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-mesh-round-report.schema.json",
  "title": "Quest Termux Lab Peer Mesh Round Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "round_id",
    "node_count",
    "initial_envelope_count",
    "direct_delivery_count",
    "relayed_envelope_count",
    "relay_passes",
    "nodes",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-mesh-round-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "node_count": {
      "type": "integer",
      "minimum": 0
    },
    "initial_envelope_count": {
      "type": "integer",
      "minimum": 0
    },
    "direct_delivery_count": {
      "type": "integer",
      "minimum": 0
    },
    "relayed_envelope_count": {
      "type": "integer",
      "minimum": 0
    },
    "relay_passes": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "inbox_envelope_count",
          "outbox_envelope_count",
          "known_peer_count",
          "forbidden_message_count",
          "summary_file"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "inbox_envelope_count": {
            "type": "integer",
            "minimum": 0
          },
          "outbox_envelope_count": {
            "type": "integer",
            "minimum": 0
          },
          "known_peer_count": {
            "type": "integer",
            "minimum": 0
          },
          "forbidden_message_count": {
            "type": "integer",
            "minimum": 0
          },
          "summary_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
