{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-scorecard-report.schema.json",
  "title": "Quest Termux Lab Peer Scorecard Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "scorecard_id",
    "experiment_scope",
    "overall_status",
    "artifacts",
    "pressure_points",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-scorecard-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "overall_status": {
      "enum": ["synthetic_clear", "manual_review", "blocked"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_kind",
          "required",
          "status",
          "source_status",
          "expected_schema",
          "observed_schema",
          "reason"
        ],
        "properties": {
          "artifact_kind": {
            "enum": [
              "readiness_report",
              "lab_bundle_report",
              "trust_report",
              "rehearsal_report",
              "evidence_intake_report",
              "route_health_report",
              "route_history_report",
              "cleanup_record"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": ["synthetic_clear", "manual_review", "blocked", "missing"]
          },
          "source_status": {
            "type": "string",
            "minLength": 1
          },
          "expected_schema": {
            "type": "string",
            "minLength": 1
          },
          "observed_schema": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pressure_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_kind",
          "status",
          "reason"
        ],
        "properties": {
          "artifact_kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["manual_review", "blocked", "missing"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "required_artifact_count",
        "synthetic_clear_count",
        "manual_review_count",
        "blocked_count",
        "missing_count"
      ],
      "properties": {
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "synthetic_clear_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
