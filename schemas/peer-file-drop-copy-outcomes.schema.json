{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-file-drop-copy-outcomes.schema.json",
  "title": "Quest Termux Lab Peer File-Drop Copy Outcomes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcomes_id",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "outcomes",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-file-drop-copy-outcomes.v1"
    },
    "outcomes_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_id",
          "target_agent_id",
          "message_id",
          "simulated_result",
          "reason"
        ],
        "properties": {
          "delivery_id": {
            "type": "string",
            "minLength": 1
          },
          "target_agent_id": {
            "type": "string",
            "minLength": 1
          },
          "message_id": {
            "type": "string",
            "minLength": 1
          },
          "simulated_result": {
            "enum": [
              "simulated_copied",
              "simulated_duplicate",
              "simulated_missing_source",
              "simulated_write_blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
