{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-topology-manifest.schema.json",
  "title": "Quest Termux Lab Peer Topology Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "topology_id",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "expected_agent_ids",
    "route_config_path",
    "route_health_report_path",
    "require_all_expected_routes",
    "require_no_unhealthy_routes",
    "min_healthy_route_count",
    "min_reachable_agent_count",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-topology-manifest.v1"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "expected_agent_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route_config_path": {
      "type": "string",
      "minLength": 1
    },
    "route_health_report_path": {
      "type": "string",
      "minLength": 1
    },
    "require_all_expected_routes": {
      "type": "boolean"
    },
    "require_no_unhealthy_routes": {
      "type": "boolean"
    },
    "min_healthy_route_count": {
      "type": "integer",
      "minimum": 0
    },
    "min_reachable_agent_count": {
      "type": "integer",
      "minimum": 0
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
