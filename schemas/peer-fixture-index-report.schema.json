{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-fixture-index-report.schema.json",
  "title": "Quest Termux Lab Peer Fixture Index Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "index_id",
    "experiment_scope",
    "overall_status",
    "fixture_groups",
    "summary",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-fixture-index-report.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "index_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "overall_status": {
      "enum": ["fixture_index_ready", "fixture_index_blocked"]
    },
    "fixture_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture_group_report"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_count",
        "expectation_passed_count",
        "expectation_failed_count",
        "ready_group_count",
        "manual_review_group_count",
        "blocked_group_count",
        "artifact_count",
        "artifact_failed_count",
        "status_check_count",
        "status_check_failed_count"
      ],
      "properties": {
        "group_count": {
          "type": "integer",
          "minimum": 0
        },
        "expectation_passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "expectation_failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_check_failed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "fixture_group_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "group_role",
        "expected_group_status",
        "observed_group_status",
        "expectation_status",
        "reason",
        "artifacts",
        "status_checks",
        "summary"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "group_role": {
          "enum": [
            "blocked_baseline",
            "clear_repeated_scorecard",
            "private_handoff_pending"
          ]
        },
        "expected_group_status": {
          "enum": ["ready", "manual_review", "blocked"]
        },
        "observed_group_status": {
          "enum": ["ready", "manual_review", "blocked"]
        },
        "expectation_status": {
          "enum": ["passed", "failed"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_report"
          }
        },
        "status_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status_check_report"
          }
        },
        "summary": {
          "$ref": "#/$defs/group_summary"
        }
      }
    },
    "artifact_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "expected_schema",
        "observed_schema",
        "status",
        "reason"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "expected_schema": {
          "type": "string",
          "minLength": 1
        },
        "observed_schema": {
          "type": "string"
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status_check_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "status_field",
        "observed_value",
        "status_class",
        "status",
        "reason"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "status_field": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {
          "type": "string"
        },
        "status_class": {
          "enum": ["ready", "manual_review", "blocked"]
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "group_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "artifact_failed_count",
        "status_check_count",
        "status_check_failed_count",
        "ready_status_count",
        "manual_review_status_count",
        "blocked_status_count"
      ],
      "properties": {
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_check_failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_status_count": {
          "type": "integer",
          "minimum": 0
        },
        "manual_review_status_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_status_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
