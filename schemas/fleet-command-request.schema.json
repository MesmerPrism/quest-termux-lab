{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/fleet-command-request.schema.json",
  "title": "Quest Termux Lab Fleet Command Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "command_id",
    "target_agent_id",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "kind",
    "requires_local_adb_shell",
    "timeout_ms",
    "max_stdout_bytes",
    "max_stderr_bytes",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.fleet-command-request.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,120}$"
    },
    "target_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "agent.status",
        "agent.capabilities",
        "termux.exec_allowlisted",
        "adb.self_check",
        "apk.update_verified",
        "adb.lease_check",
        "adb.lease_disconnect",
        "android.foreground_snapshot",
        "android.logcat_slice",
        "app.launch_allowlisted",
        "uiautomator.run_allowlisted_scenario",
        "media_projection.preview_request",
        "media_projection.preview_stop",
        "termux.agent.restart_status"
      ]
    },
    "remote_session_lease_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,120}$"
    },
    "requires_local_adb_shell": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "max_stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "max_stderr_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "enum": ["public_safe", "local_only", "private_evidence"]
    },
    "requested_by": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}
