{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-gossip-envelope.schema.json",
  "title": "Quest Termux Lab Peer Gossip Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fleet_id",
    "message_id",
    "sender_agent_id",
    "created_at",
    "hop_ttl",
    "observations",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-gossip-envelope.v1"
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,120}$"
    },
    "sender_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hop_ttl": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "observed_at",
        "heard_from_agent_id",
        "heartbeat_sequence",
        "agent_alive",
        "central_reachable",
        "local_adb_available",
        "stale_after_seconds"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "heard_from_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "heartbeat_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "agent_alive": {
          "type": "boolean"
        },
        "central_reachable": {
          "type": "boolean"
        },
        "local_adb_available": {
          "type": "boolean"
        },
        "local_adb_shell_uid": {
          "type": ["string", "null"]
        },
        "battery_percent": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "last_command_status": {
          "type": ["string", "null"]
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "summary_hash": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
