{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quest-termux-lab/peer-file-drop-staging-manifest.schema.json",
  "title": "Quest Termux Lab Peer File-Drop Staging Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "staging_plan_id",
    "fleet_id",
    "source_agent_id",
    "observed_at",
    "experiment_scope",
    "route_config_path",
    "delivery_state_path",
    "expected_message_schema",
    "authority_boundary"
  ],
  "properties": {
    "schema": {
      "const": "quest-termux-lab.peer-file-drop-staging-manifest.v1"
    },
    "staging_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "fleet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_scope": {
      "const": "private_configured_peer_gossip_only"
    },
    "route_config_path": {
      "type": "string",
      "minLength": 1
    },
    "delivery_state_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_message_schema": {
      "const": "quest-termux-lab.peer-gossip-envelope.v1"
    },
    "authority_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
