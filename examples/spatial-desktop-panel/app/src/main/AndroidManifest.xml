    <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />
    <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    <uses-native-library android:name="libossdk.oculus.so" android:required="true" />
    <activity android:name=".SpatialDesktopActivity" android:configChanges="screenSize|screenLayout|orientation|keyboard|keyboardHidden|keyboard|navigation|uiMode" android:excludeFromRecents="false" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="com.oculus.intent.category.VR" />
      </intent-filter>
    </activity>
  </application>
</manifest>
