<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FF00CC">
  <LinearLayout android:id="@+id/panel_chrome" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:background="#FFB000">
    <TextView android:id="@+id/grab_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="SPATIAL DESKTOP • grab panel" android:textColor="#101010" android:textSize="24sp" android:textStyle="bold" />
    <Button android:id="@+id/size_down" android:layout_width="48dp" android:layout_height="match_parent" android:text="−" />
    <Button android:id="@+id/size_up" android:layout_width="48dp" android:layout_height="match_parent" android:text="+" />
    <Button android:id="@+id/connect" android:layout_width="110dp" android:layout_height="match_parent" android:text="Connect" />
  </LinearLayout>
  <io.github.mesmerprism.questtermuxlab.spatialdesktop.FramebufferView android:id="@+id/framebuffer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:focusable="true" android:focusableInTouchMode="true" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:background="#1A222B">
    <Button android:id="@+id/right_click" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Right click" />
    <Button android:id="@+id/scroll_up" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Scroll ↑" />
    <Button android:id="@+id/scroll_down" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="Scroll ↓" />
    <EditText android:id="@+id/ime" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="Keyboard / ASCII or Ctrl chord" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#AAB7C4" />
  </LinearLayout>
  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="56dp" android:maxLines="2" android:gravity="center_vertical" android:padding="8dp" android:background="#FFFFFF" android:text="DISCONNECTED — shell ready; loopback 127.0.0.1:5900" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
